# =============================================================================
# Metropolis Nexus — production environment template
# Copy values into your host secret store (AWS SSM, Render, Heroku, etc.).
# Never commit real secrets. Never use development defaults in production.
# =============================================================================

# --- Core API ---
PORT=8080
DEBUG=0
# RATELIMIT_ENABLED=1  # default on; set 0 only for local integration test runs
LOG_LEVEL=INFO
# Comma-separated browser origins that may call /api/* (your SPA URL)
CORS_ORIGINS=https://app.example.com

# --- Database (Neon / RDS / managed Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth ---
# Generate: openssl rand -hex 32
# Must not be "change-me-dev-secret" when DEBUG=0
JWT_SECRET=
JWT_EXPIRES_HOURS=24

# --- AWS S3 (listing photos, presigned uploads) ---
# On ECS/EC2/Lambda you can omit keys and use an IAM instance/task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=
S3_PRESIGN_TTL_SECONDS=300

# --- Stripe (test keys in staging; live keys only in production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=  # frontend build-time

# --- Google OAuth (optional) ---
GOOGLE_OAUTH_CLIENT_ID=
# VITE_GOOGLE_OAUTH_CLIENT_ID=  # frontend build-time

# --- Product flags ---
ALLOW_USER_LISTINGS=1

# --- Gunicorn (optional overrides) ---
# FastAPI + Socket.IO: UvicornWorker (default in docker-entrypoint.prod.sh).
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
WEB_CONCURRENCY=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_FORWARDED_ALLOW_IPS=*
# Set behind reverse proxy (Render/Heroku/nginx): trust X-Forwarded-* headers
# REDIS_URL=redis://...  # required for multi-worker Socket.IO + ARQ booking sweep

# --- Frontend build-time (Vite; set in CI or static host, not on the API server) ---
# VITE_API_URL=https://api.example.com
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAP_ID=
