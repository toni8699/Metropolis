# =============================================================================
# Metropolis Nexus — production environment template
# Copy values into your host secret store (AWS SSM, Render, Heroku, etc.).
# Never commit real secrets. Never use development defaults in production.
# =============================================================================

# --- Core API ---
PORT=8080
FLASK_DEBUG=0
LOG_LEVEL=INFO
# Comma-separated browser origins that may call /api/* (your SPA URL)
CORS_ORIGINS=https://app.example.com

# --- Database (Neon / RDS / managed Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_HOURS=24

# --- AWS S3 (listing photos, presigned uploads) ---
# On ECS/EC2/Lambda you can omit keys and use an IAM instance/task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=
S3_PRESIGN_TTL_SECONDS=300

# --- Product flags ---
ALLOW_USER_LISTINGS=1

# --- Gunicorn (optional overrides) ---
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_FORWARDED_ALLOW_IPS=*
# Set behind reverse proxy (Render/Heroku/nginx): trust X-Forwarded-* headers

# --- Frontend build-time (Vite; set in CI or static host, not in Flask) ---
# VITE_API_URL=https://api.example.com
# VITE_GOOGLE_MAPS_API_KEY=
