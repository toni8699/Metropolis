# Local Vite — copy to frontend/.env.local and fill in values.
# Restart dev server after changes (docker: docker compose restart frontend).

# Backend API (5000 = local FastAPI via uvicorn / docker-compose)
VITE_API_URL=http://localhost:5000

# Google Cloud → APIs & Services → Credentials → API key
# Restrict key to your domain in production.
VITE_GOOGLE_MAPS_API_KEY=

# Google Cloud → Map Management → Map IDs → JavaScript (vector)
# Optional but recommended for host map picker (Advanced Markers).
VITE_GOOGLE_MAP_ID=

# Stripe publishable key (pk_test_...) — pair with backend STRIPE_SECRET_KEY for real card UI
# Omit locally to use dev auto-pay (backend mock path, no card form)
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Sign-In (optional; must match backend GOOGLE_OAUTH_CLIENT_ID)
VITE_GOOGLE_OAUTH_CLIENT_ID=
