# Local development — copy to .env at repo root
# See .env.production.example for the full production checklist.

# Neon Postgres (dev app only — never use for pytest)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: isolated DB for local pytest (docker-compose.test.yml or local Postgres)
# TEST_DATABASE_URL=postgresql://metropolis:metropolis@localhost:5433/metropolis_test

# Host onboarding + owner listings (0 = fleet-only mode)
ALLOW_USER_LISTINGS=1

# AWS S3 (listing photos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=
S3_PRESIGN_TTL_SECONDS=300 #
# UPLOAD_SWEEP_ENABLED=1
# UPLOAD_SWEEP_ORPHAN_GRACE_HOURS=24

# Stripe — guest checkout (optional locally; without keys, checkout auto-completes mock payment)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # Dashboard webhook → /webhooks/stripe (payment_intent.succeeded)
# Local: stripe listen --forward-to localhost:5000/webhooks/stripe
# Also set VITE_STRIPE_PUBLISHABLE_KEY=pk_test_... in frontend/.env.local (required for embedded host payouts)
# Embedded Connect onboarding uses POST /api/payouts/connect/session (no redirect)
# Connect host payouts use Accounts v2 (/v2/core/accounts) — enable Connect + embedded components in Dashboard
# STRIPE_CONNECT_API_VERSION=2026-05-27.preview
# STRIPE_CONNECT_BUSINESS_NAME=Vroom
# STRIPE_CONNECT_BUSINESS_URL=https://your-marketing-site.com  # HTTPS public URL (not localhost)
# STRIPE_CONNECT_SUPPORT_EMAIL=support@yourdomain.com

# API
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_HOURS=24
PORT=5000
DEBUG=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
LOG_LEVEL=DEBUG

# Email verification (Resend) — optional locally; required in production
# RESEND_API_KEY=re_...
# Dev/testing only (can send to your Resend account email): onboarding@resend.dev
# Production: verify your domain at https://resend.com/domains then use e.g. no-reply@yourdomain.com
# MAIL_FROM=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:5173
