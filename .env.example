# Neon Postgres (Dashboard -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional overrides instead of DATABASE_URL:
# JDBC_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
# DB_USER=
# DB_PASSWORD=

# Host onboarding + owner dashboard listing creation (set 0 for admin fleet-only demo)
ALLOW_USER_LISTINGS=1

# AWS S3 (listing photos / uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=

# Optional
JWT_SECRET=change-me-dev-secret
PORT=5000
